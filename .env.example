# Copy to .env and fill in.
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:3000

# --- Firebase ---------------------------------------------------------------
# Both values come from your Firebase web app config. The API key is a public
# project identifier, NOT a secret — access is controlled by Firestore security
# rules (see ../firestore.rules).
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Access -----------------------------------------------------------------
# Pilot: keep sign-ups closed and provision accounts via POST /api/auth/admin/users.
ALLOW_PUBLIC_SIGNUP=false
# These emails get the admin role when their account is created.
ADMIN_EMAILS=you@example.com
